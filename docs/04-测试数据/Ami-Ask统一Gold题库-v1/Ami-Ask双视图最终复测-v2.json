      "redactedSql": "WITH project_sales AS (\n  SELECT\n    SUM(ps.service_quantity) AS service_count,\n    SUM(ps.net_amount) AS project_revenue\n  FROM agent_v3_project_service_sales_view AS ps\n  WHERE ps.store_id = ANY(:allowedStoreIds)\n    AND ps.order_created_at >= :startAt::timestamptz\n    AND ps.order_created_at < :endAt::timestamptz\n)\nSELECT\n  MAX(project_sales.service_count) AS service_count,\n  MAX(project_sales.project_revenue) AS project_revenue,\n  SUM(oi.quantity) AS sales_quantity,\n  SUM(oi.net_amount) AS net_sales_amount\nFROM agent_v3_order_item_sales_view AS oi\nLEFT JOIN project_sales ON TRUE\nWHERE oi.store_id = ANY(:allowedStoreIds)\n  AND oi.order_created_at >= :startAt::timestamptz\n  AND oi.order_created_at < :endAt::timestamptz\nLIMIT 1"
    },
