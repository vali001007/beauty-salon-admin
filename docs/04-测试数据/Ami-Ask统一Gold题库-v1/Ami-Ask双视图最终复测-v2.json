      "redactedSql": "WITH usage_by_product AS (\n  SELECT m.product_id, m.product_name, m.sku, SUM(ABS(m.quantity)) AS consumed_quantity\n  FROM agent_v3_stock_movement_view AS m\n  WHERE m.store_id = ANY(:allowedStoreIds)\n    AND m.occurred_at >= :startAt::timestamptz\n    AND m.occurred_at < :endAt::timestamptz\n    AND m.quantity < 0\n    AND m.product_name ILIKE '***'\n  GROUP BY m.product_id, m.product_name, m.sku\n)\nSELECT u.product_id, u.product_name, u.sku, u.consumed_quantity, MAX(i.current_stock) AS current_stock\nFROM usage_by_product AS u\nJOIN agent_v3_product_inventory_view AS i\n  ON i.product_id = u.product_id\nWHERE i.store_id = ANY(:allowedStoreIds)\n  AND i.product_name ILIKE '***'\nGROUP BY u.product_id, u.product_name, u.sku, u.consumed_quantity\nLIMIT 100;"
    }
