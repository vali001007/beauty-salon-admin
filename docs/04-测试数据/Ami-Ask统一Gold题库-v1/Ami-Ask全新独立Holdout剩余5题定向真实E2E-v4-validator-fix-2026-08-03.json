      },
      "redactedSql": "WITH conversion_agg AS (\n  SELECT\n    mc.activity_id,\n    SUM(mc.event_count) AS event_count,\n    SUM(mc.lead_count) AS lead_count,\n    SUM(mc.conversion_count) AS conversion_count,\n    SUM(mc.attributed_revenue) AS attributed_revenue\n  FROM agent_v3_marketing_conversion_view AS mc\n  WHERE mc.store_id = ANY(:allowedStoreIds)\n    AND mc.latest_event_at >= :startAt::timestamptz\n    AND mc.latest_event_at < :endAt::timestamptz\n  GROUP BY mc.activity_id\n)\nSELECT\n  ma.activity_id AS activity_id,\n  ma.activity_title AS activity_title,\n  SUM(ma.participants) AS participants,\n  SUM(conversion_agg.event_count) AS event_count,\n  SUM(conversion_agg.lead_count) AS lead_count,\n  SUM(conversion_agg.conversion_count) AS conversion_count,\n  SUM(conversion_agg.attributed_revenue) AS attributed_revenue\nFROM agent_v3_marketing_activity_view AS ma\nLEFT JOIN conversion_agg\n  ON conversion_agg.activity_id = ma.activity_id\nWHERE ma.store_id = ANY(:allowedStoreIds)\n  AND ma.start_at >= :startAt::timestamptz\n  AND ma.start_at < :endAt::timestamptz\nGROUP BY ma.activity_id, ma.activity_title\nLIMIT 100;"
    },
