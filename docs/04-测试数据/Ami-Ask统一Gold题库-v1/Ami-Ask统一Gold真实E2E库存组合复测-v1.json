      "redactedSql": "SELECT m.product_id, m.product_name, m.sku, SUM(ABS(m.quantity)) AS consumed_quantity, MAX(i.current_stock) AS current_stock FROM agent_v3_stock_movement_view AS m JOIN agent_v3_product_inventory_view AS i ON i.store_id = m.store_id AND i.product_id = m.product_id WHERE m.store_id = ANY(:allowedStoreIds) AND m.occurred_at >= :startAt AND m.occurred_at < :endAt AND i.store_id = ANY(:allowedStoreIds) AND (m.quantity < 0 AND m.product_name ILIKE '***' AND m.occurred_at >= :startAt::timestamptz AND m.occurred_at < :endAt::timestamptz) GROUP BY m.product_id, m.product_name, m.sku LIMIT 1;"
