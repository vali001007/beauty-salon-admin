      "answerMs": 0,
      "redactedSql": "WITH project_sales AS (\n  SELECT\n    SUM(service_quantity) AS service_count,\n    SUM(net_amount) AS project_revenue\n  FROM agent_v3_project_service_sales_view\n  WHERE order_created_at >= :startAt::timestamptz\n    AND order_created_at < :endAt::timestamptz\n)\nSELECT\n  MAX(project_sales.service_count) AS service_count,\n  MAX(project_sales.project_revenue) AS project_revenue,\n  SUM(order_items.quantity) AS sales_quantity,\n  SUM(order_items.net_amount) AS net_sales_amount\nFROM agent_v3_order_item_sales_view AS order_items\nJOIN project_sales ON TRUE\nWHERE order_items.order_created_at >= :startAt::timestamptz\n  AND order_items.order_created_at < :endAt::timestamptz\nLIMIT 1"
    },
