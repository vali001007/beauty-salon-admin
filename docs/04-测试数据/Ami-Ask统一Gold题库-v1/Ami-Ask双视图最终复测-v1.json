      "executionMs": 0,
      "answerMs": 0,
      "redactedSql": "WITH usage AS (\n  SELECT\n    m.product_id,\n    m.product_name,\n    m.sku,\n    SUM(ABS(m.quantity)) AS consumed_quantity\n  FROM agent_v3_stock_movement_view AS m\n  WHERE m.store_id = ANY(:allowedStoreIds)\n    AND m.quantity < 0\n    AND m.product_name ILIKE '***'\n    AND m.occurred_at >= :startAt::timestamptz\n    AND m.occurred_at < :endAt::timestamptz\n  GROUP BY m.product_id, m.product_name, m.sku\n)\nSELECT\n  MAX(u.product_id) AS product_id,\n  MAX(u.product_name) AS product_name,\n  MAX(u.sku) AS sku,\n  MAX(u.consumed_quantity) AS consumed_quantity,\n  MAX(i.current_stock) AS current_stock\nFROM usage AS u\nJOIN agent_v3_product_inventory_view AS i\n  ON i.product_id = u.product_id\n  AND i.store_id = ANY(:allowedStoreIds)\nLIMIT 1;"
    }
