      "redactedSql": "SELECT staff_id, staff_name, SUM(scheduled_minutes) AS scheduled_minutes, SUM(booked_minutes) AS booked_minutes, SUM(idle_minutes) AS idle_minutes, SUM(overbooked_minutes) AS overbooked_minutes, SUM(booked_minutes) / NULLIF(SUM(scheduled_minutes), 0) AS utilization_rate, MAX(work_date) AS work_date FROM ask_data_staff_capacity_view WHERE ask_data_staff_capacity_view.store_id = ANY(:allowedStoreIds) AND ask_data_staff_capacity_view.work_date >= :startAt AND ask_data_staff_capacity_view.work_date < :endAt AND (work_date >= :startAt::date AND work_date < :endAt::date) GROUP BY staff_id, staff_name HAVING SUM(overbooked_minutes) > 0 ORDER BY overbooked_minutes DESC LIMIT 100;"
