      "redactedSql": "WITH project_summary AS (SELECT SUM(ps.service_quantity) AS service_count, SUM(ps.net_amount) AS project_revenue FROM agent_v3_project_service_sales_view ps WHERE ps.store_id = ANY(:allowedStoreIds) AND ps.order_created_at >= :startAt::timestamptz AND ps.order_created_at < :endAt::timestamptz) SELECT MAX(project_summary.service_count) AS service_count, MAX(project_summary.project_revenue) AS project_revenue, SUM(product_sales.quantity) AS sales_quantity, SUM(product_sales.net_amount) AS net_sales_amount FROM agent_v3_order_item_sales_view product_sales RIGHT JOIN project_summary ON TRUE AND product_sales.store_id = ANY(:allowedStoreIds) AND product_sales.order_created_at >= :startAt::timestamptz AND product_sales.order_created_at < :endAt::timestamptz LIMIT 1;"
