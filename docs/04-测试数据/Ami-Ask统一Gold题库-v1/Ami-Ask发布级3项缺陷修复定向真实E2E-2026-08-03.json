        ],
        "caveats": []
      },
      "redactedSql": "SELECT COALESCE(SUM(net_amount) FILTER (WHERE order_created_at >= DATE_TRUNC('***', :endAt::date) - INTERVAL '***' AND order_created_at < DATE_TRUNC('***', :endAt::date)), 0) AS current_period_net_revenue, COALESCE(SUM(net_amount) FILTER (WHERE order_created_at >= DATE_TRUNC('***', :endAt::date) - INTERVAL '***' AND order_created_at < DATE_TRUNC('***', :endAt::date) - INTERVAL '***'), 0) AS previous_period_net_revenue, COALESCE(SUM(net_amount) FILTER (WHERE order_created_at >= DATE_TRUNC('***', :endAt::date) - INTERVAL '***' AND order_created_at < DATE_TRUNC('***', :endAt::date)), 0) - COALESCE(SUM(net_amount) FILTER (WHERE order_created_at >= DATE_TRUNC('***', :endAt::date) - INTERVAL '***' AND order_created_at < DATE_TRUNC('***', :endAt::date) - INTERVAL '***'), 0) AS revenue_difference FROM agent_v3_order_summary_view WHERE agent_v3_order_summary_view.store_id = ANY(:allowedStoreIds) AND agent_v3_order_summary_view.order_created_at >= :startAt AND agent_v3_order_summary_view.order_created_at < :endAt LIMIT 1;"
