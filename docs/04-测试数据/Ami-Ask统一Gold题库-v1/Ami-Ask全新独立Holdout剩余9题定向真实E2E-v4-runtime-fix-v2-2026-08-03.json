      "answer": {
        "summary": "查询结果为：日结净收=0 元、订单数=0、订单净收入=0 元、order settlement difference=0。",
        "keyFindings": [
          "日结净收=0 元、订单数=0、订单净收入=0 元、order settlement difference=0"
        ],
        "caveats": []
      },
      "redactedSql": "WITH settlement_totals AS (\n  SELECT\n    COALESCE(SUM(ds.net_amount), 0) AS net_receipts,\n    COALESCE(SUM(ds.order_count), 0) AS order_count\n  FROM agent_v3_daily_settlement_view AS ds\n  WHERE ds.store_id = ANY(:allowedStoreIds)\n    AND ds.settlement_date >= :startAt::date\n    AND ds.settlement_date < :endAt::date\n)\nSELECT\n  COALESCE(SUM(os.net_amount), 0) AS net_revenue,\n  COALESCE(MAX(st.net_receipts), 0) AS net_receipts,\n  COALESCE(MAX(st.order_count), 0) AS order_count,\n  COALESCE(SUM(os.net_amount), 0) - COALESCE(MAX(st.net_receipts), 0) AS order_settlement_difference\nFROM agent_v3_order_summary_view AS os\nCROSS JOIN settlement_totals AS st\nWHERE os.store_id = ANY(:allowedStoreIds)\n  AND os.order_created_at >= :startAt\n  AND os.order_created_at < :endAt\nLIMIT 1;"
    },
