      "redactedSql": "WITH conversion_metrics AS (\n  SELECT c.activity_id,\n         COALESCE(SUM(c.event_count), 0) AS event_count,\n         COALESCE(SUM(c.lead_count), 0) AS lead_count,\n         COALESCE(SUM(c.conversion_count), 0) AS conversion_count,\n         COALESCE(SUM(c.attributed_revenue), 0) AS attributed_revenue\n  FROM agent_v3_marketing_conversion_view AS c\n  WHERE c.store_id = ANY(:allowedStoreIds)\n    AND c.latest_event_at >= :startAt::timestamptz\n    AND c.latest_event_at < :endAt::timestamptz\n  GROUP BY c.activity_id\n)\nSELECT a.activity_id,\n       a.activity_title,\n       SUM(a.participants) AS participants,\n       COALESCE(MAX(cm.event_count), 0) AS event_count,\n       COALESCE(MAX(cm.lead_count), 0) AS lead_count,\n       COALESCE(MAX(cm.conversion_count), 0) AS conversion_count,\n       COALESCE(MAX(cm.attributed_revenue), 0) AS attributed_revenue\nFROM agent_v3_marketing_activity_view AS a\nLEFT JOIN conversion_metrics AS cm\n  ON cm.activity_id = a.activity_id\nWHERE a.store_id = ANY(:allowedStoreIds)\n  AND a.start_at >= :startAt::timestamptz\n  AND a.start_at < :endAt::timestamptz\nGROUP BY a.activity_id, a.activity_title\nLIMIT 100;"
    },
