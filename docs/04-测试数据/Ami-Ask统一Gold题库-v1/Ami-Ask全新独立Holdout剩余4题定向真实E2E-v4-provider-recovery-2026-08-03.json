      "redactedSql": "WITH project_sales AS (\n  SELECT\n    s.project_id,\n    COALESCE(SUM(s.net_amount), 0) AS project_revenue,\n    COALESCE(SUM(s.estimated_margin), 0) AS estimated_margin\n  FROM agent_v3_project_service_sales_view AS s\n  WHERE s.store_id = ANY(:allowedStoreIds)\n    AND s.order_created_at >= :startAt::timestamptz\n    AND s.order_created_at < :endAt::timestamptz\n  GROUP BY s.project_id\n)\nSELECT\n  b.movement_id,\n  b.project_id,\n  b.project_name,\n  b.product_id,\n  b.product_name,\n  b.sku,\n  b.standard_qty AS standard_qty,\n  b.actual_qty AS actual_qty,\n  b.deviation_qty AS deviation_qty,\n  b.deviation_rate AS deviation_rate,\n  COALESCE(MAX(ps.project_revenue), 0) AS project_revenue,\n  COALESCE(MAX(ps.estimated_margin), 0) AS estimated_margin,\n  b.standard_status,\n  b.occurred_at\nFROM ask_data_bom_consumption_variance_view AS b\nLEFT JOIN project_sales AS ps\n  ON ps.project_id = b.project_id\nWHERE b.store_id = ANY(:allowedStoreIds)\n  AND b.occurred_at >= :startAt::timestamptz\n  AND b.occurred_at < :endAt::timestamptz\n  AND b.standard_status = '***'\n  AND b.is_abnormal = true\nGROUP BY\n  b.movement_id,\n  b.project_id,\n  b.project_name,\n  b.product_id,\n  b.product_name,\n  b.sku,\n  b.standard_qty,\n  b.actual_qty,\n  b.deviation_qty,\n  b.deviation_rate,\n  b.standard_status,\n  b.occurred_at\nLIMIT 100;"
    }
