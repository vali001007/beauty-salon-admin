        "keyFindings": [],
        "caveats": []
      },
      "redactedSql": "WITH conversion_agg AS (\n  SELECT\n    c.activity_id,\n    COALESCE(SUM(c.event_count), 0) AS event_count,\n    COALESCE(SUM(c.lead_count), 0) AS lead_count,\n    COALESCE(SUM(c.attributed_revenue), 0) AS attributed_revenue\n  FROM agent_v3_marketing_conversion_view AS c\n  WHERE c.store_id = ANY(:allowedStoreIds)\n    AND c.latest_event_at >= :startAt::timestamptz\n    AND c.latest_event_at < :endAt::timestamptz\n  GROUP BY c.activity_id\n)\nSELECT\n  r.activity_id AS activity_id,\n  r.activity_title AS activity_title,\n  SUM(r.exposure_count) AS exposure_count,\n  SUM(r.click_count) AS click_count,\n  SUM(r.conversion_count) AS conversion_count,\n  SUM(r.attributed_net_revenue) AS attributed_net_revenue,\n  SUM(r.marketing_cost) AS marketing_cost,\n  SUM(r.attributed_net_revenue) / NULLIF(SUM(r.marketing_cost), 0) AS roi,\n  MAX(r.cost_source) AS cost_source,\n  COALESCE(MAX(ca.event_count), 0) AS event_count,\n  COALESCE(MAX(ca.lead_count), 0) AS lead_count,\n  COALESCE(MAX(ca.attributed_revenue), 0) AS attributed_revenue\nFROM ask_data_marketing_roi_view AS r\nLEFT JOIN conversion_agg AS ca\n  ON ca.activity_id = r.activity_id\nWHERE r.store_id = ANY(:allowedStoreIds)\n  AND r.effect_date >= :startAt::timestamptz\n  AND r.effect_date < :endAt::timestamptz\n  AND r.activity_id IS NOT NULL\n  AND r.activity_title IS NOT NULL\nGROUP BY r.activity_id, r.activity_title\nLIMIT 100;"
    }
  ]
