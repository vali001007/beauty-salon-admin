      "redactedSql": "SELECT v.staff_id, v.staff_name, v.work_date, SUM(v.scheduled_minutes) AS scheduled_minutes, SUM(v.booked_minutes) AS booked_minutes, SUM(v.idle_minutes) AS idle_minutes, SUM(v.overbooked_minutes) AS overbooked_minutes, SUM(v.booked_minutes) / NULLIF(SUM(v.scheduled_minutes), 0) AS utilization_rate FROM ask_data_staff_capacity_view AS v WHERE v.store_id = ANY(:allowedStoreIds) AND v.work_date >= :startAt AND v.work_date < :endAt AND (v.store_id = ANY(:allowedStoreIds) AND v.work_date >= :startAt::date AND v.work_date < :endAt::date) GROUP BY v.staff_id, v.staff_name, v.work_date HAVING SUM(v.overbooked_minutes) > 0 ORDER BY overbooked_minutes DESC LIMIT 100;"
