      "answer": {
        "summary": "已查询到 2 条结果，首条为 商品 ID=84、商品名称=氨基酸洁面乳、SKU=AMI-DEMO-FULL-SKU-003、消耗数量=0、当前库存=164。",
        "keyFindings": [
          "商品 ID=84、商品名称=氨基酸洁面乳、SKU=AMI-DEMO-FULL-SKU-003、消耗数量=0、当前库存=164",
          "商品 ID=110、商品名称=院装温和洁面乳、SKU=IND-6-STD-CLEANSER-PRO-001、消耗数量=0、当前库存=88"
        ],
        "caveats": []
      },
      "redactedSql": "WITH usage_by_product AS (\n  SELECT\n    m.product_id,\n    SUM(ABS(m.quantity)) AS consumed_quantity\n  FROM agent_v3_stock_movement_view AS m\n  WHERE m.store_id = ANY(:allowedStoreIds)\n    AND m.occurred_at >= :startAt::date\n    AND m.occurred_at < :endAt::date\n    AND m.quantity < 0\n    AND m.product_name LIKE '***'\n  GROUP BY m.product_id\n)\nSELECT\n  p.product_id,\n  p.product_name,\n  p.sku,\n  COALESCE(MAX(u.consumed_quantity), 0) AS consumed_quantity,\n  MAX(p.current_stock) AS current_stock\nFROM agent_v3_product_inventory_view AS p\nLEFT JOIN usage_by_product AS u\n  ON u.product_id = p.product_id\nWHERE p.store_id = ANY(:allowedStoreIds)\n  AND p.product_name LIKE '***'\nGROUP BY p.product_id, p.product_name, p.sku\nLIMIT 100;"
    }
  ]
