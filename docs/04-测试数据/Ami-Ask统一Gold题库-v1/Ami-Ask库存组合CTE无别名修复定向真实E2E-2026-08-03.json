      },
      "redactedSql": "WITH consumed AS (\n  SELECT m.product_id, m.product_name, m.sku, SUM(ABS(m.quantity)) AS consumed_quantity\n  FROM agent_v3_stock_movement_view AS m\n  WHERE m.store_id = ANY(:allowedStoreIds)\n    AND m.occurred_at >= :startAt::timestamptz\n    AND m.occurred_at < :endAt::timestamptz\n    AND m.quantity < 0\n    AND m.product_name ILIKE '***'\n  GROUP BY m.product_id, m.product_name, m.sku\n)\nSELECT p.product_id, p.product_name, p.sku, COALESCE(MAX(c.consumed_quantity), 0) AS consumed_quantity, MAX(p.current_stock) AS current_stock\nFROM agent_v3_product_inventory_view AS p\nLEFT JOIN consumed AS c ON c.product_id = p.product_id\nWHERE p.store_id = ANY(:allowedStoreIds)\n  AND p.product_name ILIKE '***'\nGROUP BY p.product_id, p.product_name, p.sku\nLIMIT 100;"
    }
