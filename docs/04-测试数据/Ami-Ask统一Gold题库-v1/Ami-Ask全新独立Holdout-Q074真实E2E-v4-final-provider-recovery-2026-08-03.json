      "answer": {
        "summary": "明天有有效预约的美容师中，宋乔空闲时间最多，为900分钟。",
        "keyFindings": [
          "宋乔：空闲900分钟，排班960分钟，已预约60分钟，1个预约，利用率6.25%。",
          "唐伊：空闲800分钟，排班900分钟，已预约190分钟，2个预约，超排90分钟，利用率21.11%。",
          "沈晴：空闲585分钟，排班660分钟，已预约75分钟，1个预约，利用率11.36%。",
          "按空闲分钟降序，当前返回3名有有效预约的美容师。",
          "已取消预约不计入预约数量和预约分钟；利用率按汇总预约分钟除以汇总排班分钟计算。"
        ],
        "caveats": [
          "未指定排行数量，默认返回前10名。"
        ]
      },
      "redactedSql": "WITH reservation_counts AS (\n  SELECT r.beautician_id,\n         COUNT(DISTINCT r.reservation_id) AS reservation_count\n  FROM agent_v3_reservation_view AS r\n  WHERE r.store_id = ANY(:allowedStoreIds)\n    AND r.date >= :startAt::date\n    AND r.date < :endAt::date\n    AND r.status NOT IN ('***', '***', '***', '***')\n  GROUP BY r.beautician_id\n)\nSELECT c.staff_id,\n       c.staff_name,\n       SUM(c.scheduled_minutes) AS scheduled_minutes,\n       SUM(c.booked_minutes) AS booked_minutes,\n       SUM(c.idle_minutes) AS idle_minutes,\n       SUM(c.overbooked_minutes) AS overbooked_minutes,\n       SUM(c.booked_minutes)::numeric / NULLIF(SUM(c.scheduled_minutes), 0) AS utilization_rate,\n       MAX(rc.reservation_count) AS reservation_count\nFROM ask_data_staff_capacity_view AS c\nJOIN reservation_counts AS rc\n  ON rc.beautician_id = c.staff_id\nWHERE c.store_id = ANY(:allowedStoreIds)\n  AND c.work_date >= :startAt::date\n  AND c.work_date < :endAt::date\nGROUP BY c.staff_id, c.staff_name\nORDER BY idle_minutes DESC\nLIMIT 10;"
    }
  ]
