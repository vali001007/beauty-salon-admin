      "redactedSql": "SELECT settlement_date, SUM(revenue_amount) AS revenue_amount, SUM(paid_amount) AS paid_amount, SUM(refund_amount) AS refund_amount, SUM(net_amount) AS net_amount, SUM(paid_amount) - SUM(refund_amount) - SUM(net_amount) AS settlement_difference, SUM(order_count) AS order_count, SUM(customer_count) AS customer_count FROM agent_v3_daily_settlement_view WHERE agent_v3_daily_settlement_view.store_id = ANY(:allowedStoreIds) AND agent_v3_daily_settlement_view.settlement_date >= :startAt AND agent_v3_daily_settlement_view.settlement_date < :endAt AND (settlement_date BETWEEN :startAt::date AND :endAt::date) GROUP BY settlement_date ORDER BY settlement_date ASC LIMIT 100;"
