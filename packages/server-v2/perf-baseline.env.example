# Copy to packages/server-v2/.env.perf.local and fill values locally.
# Never commit the local file or send its password in chat.

PERF_BASE_URL=http://127.0.0.1:8080
PERF_LOGIN_USERNAME=
PERF_LOGIN_PASSWORD=
PERF_STORE_ID=
PERF_ITERATIONS=5

# skip: no Brain request; readback: read existing messages; execute: send deterministic metric questions.
PERF_BRAIN_MODE=skip
PERF_BRAIN_CONVERSATION_ID=
PERF_BRAIN_QUESTION=查询本月订单实收金额和平均客单价
PERF_BRAIN_ROLE_HINT=finance
PERF_BRAIN_ITERATIONS=3

PERF_OUTPUT_PATH=packages/server-v2/performance-baseline-output/perf-baseline-latest.json
